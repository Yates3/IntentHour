{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.desktop.config.ts",
    "playwright.desktop-installed.config.ts",
    "drizzle.config.ts",
    "desktop/vite.config.ts",
    "desktop/**/*.ts",
    "desktop/**/*.cts"
  ]
}
